{
  "name": "elysia-drizzle",
  "version": "1.0.50",
  "scripts": {
    "start": "./server",
    "dev": "bun --env-file=.env.local run --watch src/index.ts",
    "test": "bun --env-file=.env.local test",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server src/index.ts"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.14",
    "drizzle-orm": "^0.45.1",
    "ejs": "^5.0.1",
    "elysia": "latest",
    "nodemailer": "^8.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/ejs": "^3.1.5",
    "@types/nodemailer": "^7.0.11",
    "drizzle-kit": "^0.31.9"
  },
  "module": "src/index.js"
}